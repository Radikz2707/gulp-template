{
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist/js",
    "rootDir": "src",
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "5.0",
    "strict": true, // <--- ИЗМЕНЕНО: включи строгость для реальной пользы
    "isolatedModules": true, // <--- ДОБАВЛЕНО: для корректной работы с Webpack
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/js/*"],
      "@comp/*": ["./src/components/*"],
      "@plugins/*": ["./src/js/plugins/*"]
    },
    "allowJs": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
