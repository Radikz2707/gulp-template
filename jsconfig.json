{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",

    /* Работа с файлами */
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Пути (BaseUrl можно оставить, если стоит ignoreDeprecations) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/js/*"],
      "@comp/*": ["./src/components/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "archives"]
}
